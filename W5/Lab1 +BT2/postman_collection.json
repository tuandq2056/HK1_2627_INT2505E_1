{
  "info": {
    "_postman_id": "c8a42e5b-3b48-4e12-8e6d-98319f6a1523",
    "name": "Bookstore API - Pagination & Filtering (Homework 2)",
    "description": "Postman Collection for Homework 2 (Buổi 5): Offset & Cursor Pagination, Genre Filter, Multi-key Sort, and Schema Validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "cursor_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Offset Pagination",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/books?strategy=offset&offset=0&limit=3",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "books"],
          "query": [
            {"key": "strategy", "value": "offset"},
            {"key": "offset", "value": "0"},
            {"key": "limit", "value": "3"}
          ]
        }
      }
    },
    {
      "name": "2. Cursor Pagination (Page 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.pagination && jsonData.pagination.next_cursor) {",
              "    pm.collectionVariables.set('cursor_token', jsonData.pagination.next_cursor);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/books?strategy=cursor&limit=3&sort=-price",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "books"],
          "query": [
            {"key": "strategy", "value": "cursor"},
            {"key": "limit", "value": "3"},
            {"key": "sort", "value": "-price"}
          ]
        }
      }
    },
    {
      "name": "3. Cursor Pagination (Page 2 using Cursor Token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/books?strategy=cursor&limit=3&sort=-price&cursor={{cursor_token}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "books"],
          "query": [
            {"key": "strategy", "value": "cursor"},
            {"key": "limit", "value": "3"},
            {"key": "sort", "value": "-price"},
            {"key": "cursor", "value": "{{cursor_token}}"}
          ]
        }
      }
    },
    {
      "name": "4. Filter by Genre",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/books?genre=fiction",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "books"],
          "query": [
            {"key": "genre", "value": "fiction"}
          ]
        }
      }
    },
    {
      "name": "5. Multi-key Sort (-price,title)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/books?strategy=offset&sort=-price,title&limit=10",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "books"],
          "query": [
            {"key": "strategy", "value": "offset"},
            {"key": "sort", "value": "-price,title"},
            {"key": "limit", "value": "10"}
          ]
        }
      }
    },
    {
      "name": "6. Create Book (Success)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Architecture\",\n  \"isbn\": \"9780134494166\",\n  \"genre\": \"tech\",\n  \"price_vnd\": 490000,\n  \"stock\": 10\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/books",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "books"]
        }
      }
    },
    {
      "name": "7. Create Book (Validation Fail - missing title)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"genre\": \"tech\",\n  \"price_vnd\": 490000\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/books",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "books"]
        }
      }
    },
    {
      "name": "8. Get Book by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/books/1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "books", "1"]
        }
      }
    },
    {
      "name": "9. Delete Book by ID",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/books/1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "books", "1"]
        }
      }
    }
  ]
}
