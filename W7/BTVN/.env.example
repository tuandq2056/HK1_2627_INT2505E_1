# DB — local dùng SQLite; docker-compose tự set Postgres
DB_URL=sqlite:///dev.db
# DB_URL=postgresql+psycopg://app:devpw@db:5432/appdb
# Flask
SECRET_KEY=<tao-bang-secrets-token-urlsafe-32>
APP_CONFIG=product_api.config.DefaultConfig
# Log
LOG_LEVEL=INFO
# Port expose ra host khi chạy docker compose
API_PORT=5000
